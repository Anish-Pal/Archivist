# Copy to deploy/aws/.env on the instance and fill in. Never commit the real file.
#
# Neon connection string. Use the pooled endpoint and keep sslmode=require.
DB_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/archivist?sslmode=require

# Groq API key used for answer generation and query rewriting.
GROQ_API_KEY=
