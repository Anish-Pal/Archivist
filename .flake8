[flake8]
max-line-length = 120

exclude =
    .git,
    .venv,
    venv,
    __pycache__,
    alembic/versions,
    data,
    chroma_db

# The codebase deliberately uses spaced-out call syntax (`Depends , get_db`,
# `key = "value"`), free-form continuation indentation and blank-line runs as
# section separators. Those are style choices applied consistently across every
# module, not defects, so they are not enforced.
#
# Ignored: E115/E116 comment indentation, E117 over-indented block,
# E122/E124/E125/E128/E131 continuation-line indentation, E203 whitespace
# before ':'/',', E211 whitespace before bracket, E221/E222 multiple spaces
# around operator, E251 spaces around keyword equals, E265 block comment
# format, E301/E302/E303/E305 blank-line counts, W504 break after operator.
#
# Still enforced: every pyflakes check (F) — undefined and unused names —
# plus trailing whitespace, end-of-file newlines, line length, comparison
# correctness (E711/E712), bare excepts (E722) and syntax errors (E9).
extend-ignore = E115,E116,E117,E122,E124,E125,E128,E131,E203,E211,E221,E222,E251,E265,E301,E302,E303,E305,W504
