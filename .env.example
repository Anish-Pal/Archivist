# Copy to .env for local development. Never commit the real .env.
# In deployment these are set as Space secrets, not from a file.

# PostgreSQL connection string.
# Local:  postgresql://user:password@localhost:5432/archivist
# Neon:   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/archivist?sslmode=require
DB_URL=postgresql://user:password@localhost:5432/archivist

# Groq API key — used for answer generation and query rewriting.
GROQ_API_KEY=

# Hugging Face token. Only needed for gated model downloads; the embedding
# and reranker models used here are public.
HF_TOKEN=

# Storage locations. Defaults shown; deployment points these at a mounted
# volume (e.g. /data/uploads and /data/chroma_db).
# DATA_FOLDER=data
# CHROMA_DB_PATH=chroma_db

# Send the session cookie only over HTTPS. Leave false for local http://.
COOKIE_SECURE=false
